# Generated by scripts/package-release.py. Packages the verified release binary.
#
# The binary is shipped exactly as built and tested: test-package.py asserts the
# packaged bytes equal the tested bytes, so rpm must not strip it or extract a
# debuginfo package, which would rewrite it. This mirrors the Arch recipe's
# !strip/!debug options.
%global debug_package %{nil}
%global __os_install_post %{nil}

Name:           decklock
Version:        @VERSION@
Release:        1%{?dist}
Summary:        Customizable Wayland lock screen with native GTK4 settings and bundled media
# No project-wide license has been selected by the author yet. This is not an
# SPDX grant, and the package is therefore not suitable for submission to the
# Fedora repositories.
License:        LicenseRef-None
URL:            https://github.com/yan-vidal/DeckLock
Source0:        decklock-%{version}-fedora-@ARCH@.tar.gz
ExclusiveArch:  @ARCH@
BuildRequires:  coreutils

# Shared libraries the binary links, including gtk4-layer-shell, are detected
# from the ELF headers. These are loaded through dlopen at runtime instead, so
# nothing in the binary reveals them.
Requires:       gstreamer1-plugins-base
Requires:       gstreamer1-plugins-good
Requires:       gstreamer1-libav
Requires:       pam
Recommends:     gstreamer1-plugins-bad-free
Recommends:     systemd

%description
DeckLock locks a Wayland session through ext-session-lock-v1, with a native
GTK4 settings application, configurable themes, procedural and video media,
an on-screen keyboard and offline bilingual help.

Real locking requires a Wayland compositor implementing ext-session-lock-v1
or an X11 session. Compositors without ext-session-lock-v1 (such as KDE Plasma
and GNOME on Wayland) are not supported.

%prep
# Verify the payload the way the Arch recipe's sha256sums does: the archive must
# be exactly the one test-package.py checksummed, or the build stops here.
echo '@SHA256@  %{SOURCE0}' | sha256sum --check -
%setup -q -n decklock-%{version}-fedora-@ARCH@

%install
install -Dm755 bin/decklock %{buildroot}%{_bindir}/decklock
install -d %{buildroot}%{_datadir}
cp -a share/. %{buildroot}%{_datadir}/
install -Dm644 pam/decklock %{buildroot}%{_sysconfdir}/pam.d/decklock
install -Dm644 BUILD-INFO.json %{buildroot}%{_datadir}/doc/decklock/BUILD-INFO.json

%files
%{_bindir}/decklock
%{_datadir}/decklock/
%{_datadir}/applications/io.github.yan_vidal.DeckLock.desktop
%{_datadir}/icons/hicolor/*/apps/io.github.yan_vidal.DeckLock*.svg
%{_datadir}/doc/decklock/
# Authentication policy the administrator may edit; rpm must not replace it.
%config(noreplace) %{_sysconfdir}/pam.d/decklock

%changelog
* Tue Sep 15 2026 DeckLock packaging - @VERSION@-1
- Reviewed user-facing changes are recorded in CHANGELOG.md.
