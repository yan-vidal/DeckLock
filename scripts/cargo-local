#!/bin/sh
# Development-only native library prefix, when a distro package is unavailable.
set -eu
project_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -d "$project_dir/.deps/install/lib" ]; then
    export PKG_CONFIG_PATH="$project_dir/.deps/install/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
    export LD_LIBRARY_PATH="$project_dir/.deps/install/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
cd "$project_dir"
exec cargo "$@"
