#!/bin/sh
# Run in the isolated Arch CI container as an unprivileged user.
set -eu
cargo build --release --locked
cargo test --release --locked --test cli_contract --test session_invariants
python3 scripts/test-package.py --binary target/release/decklock
python3 scripts/package-release.py
cd dist
makepkg --nodeps
sha256sum decklock-*.pkg.tar.zst >> SHA256SUMS
sha256sum --check SHA256SUMS
