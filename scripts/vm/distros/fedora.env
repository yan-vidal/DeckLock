# Guest provisioning data for Fedora. Sourced by setup.sh: data only, no logic.
PRE_SYNC=''
SYNC_AND_INSTALL='dnf install -y'
HARNESS_PACKAGES='sway wtype python3-gobject gtk4 gtk4-layer-shell gstreamer1 gstreamer1-plugins-base gstreamer1-plugins-good gstreamer1-libav pam grim at-spi2-core dbus-daemon'
INSTALL_CANDIDATE='dnf install -y'
REINSTALL_CANDIDATE='dnf reinstall -y'
CANDIDATE_GLOB='*.rpm'
QUERY_PACKAGES='rpm -qa'
PAM_EVIDENCE='login system-auth password-auth'
