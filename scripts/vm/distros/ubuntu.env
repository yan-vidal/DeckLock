# Guest provisioning data for Ubuntu. Sourced by setup.sh: data only, no logic.
PRE_SYNC='apt-get update'
SYNC_AND_INSTALL='apt-get install -y'
HARNESS_PACKAGES='sway wtype python3-gi libgtk-4-1 libgtk4-layer-shell0 gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-libav libpam-modules libpam-modules-bin grim at-spi2-core dbus'
INSTALL_CANDIDATE='apt-get install -y'
REINSTALL_CANDIDATE='apt-get install -y --reinstall'
CANDIDATE_GLOB='*.deb'
QUERY_PACKAGES='dpkg-query -W'
PAM_EVIDENCE='login common-auth common-account common-session'
