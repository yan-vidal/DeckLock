# Guest provisioning data for Ubuntu. Sourced by setup.sh: data only, no logic.
PRE_SYNC='apt-get update'
SYNC_AND_INSTALL='apt-get install -y'
# Debian-family packaging splits GObject introspection typelibs into gir1.2-*
# packages, while Arch and Fedora ship them inside the library packages.
# exercise.py needs Atspi 2.0 and probe.py needs Gtk 4.0, so both are named.
HARNESS_PACKAGES='sway labwc wayfire wtype greetd cage python3-gi gir1.2-atspi-2.0 gir1.2-gtk-4.0 libgtk-4-1 libgtk4-layer-shell0 gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-libav libpam-modules libpam-modules-bin grim at-spi2-core dbus xvfb xdotool'
# Compositors scripts/vm/compositor.py repeats the lock boundary on, after Sway.
EXTRA_COMPOSITORS='labwc wayfire'
INSTALL_CANDIDATE='apt-get install -y'
REINSTALL_CANDIDATE='apt-get install -y --reinstall'
CANDIDATE_GLOB='*.deb'
QUERY_PACKAGES='dpkg-query -W'
PAM_EVIDENCE='login common-auth common-account common-session'
