# Guest provisioning data for Arch. Sourced by setup.sh: data only, no logic.
PRE_SYNC=''
SYNC_AND_INSTALL='pacman -Syu --noconfirm --needed'
HARNESS_PACKAGES='sway labwc wayfire wtype greetd cage hyprland python-gobject gtk4 gtk4-layer-shell gstreamer gst-plugins-base gst-plugins-good gst-libav pam grim at-spi2-core dbus xorg-server-xvfb xdotool'
# Compositors scripts/vm/compositor.py repeats the lock boundary on, after Sway.
EXTRA_COMPOSITORS='labwc wayfire'
# Login compositors whose `decklock setup greeter` greeter.py runs as root against the
# installed compositor. Hyprland only verifies its configuration here: compositor.py
# cannot start it in this guest.
SETUP_COMPOSITORS='hyprland'
INSTALL_CANDIDATE='pacman -U --noconfirm'
REINSTALL_CANDIDATE='pacman -U --noconfirm'
CANDIDATE_GLOB='*.pkg.tar.zst'
QUERY_PACKAGES='pacman -Q'
PAM_EVIDENCE='login system-local-login system-login system-auth'
