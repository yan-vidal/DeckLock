#!/usr/bin/env python3
"""One-time theme conversion; Python is not required to run the resulting Rust theme."""
import argparse
import json
import os
from pathlib import Path
import re

ROOT = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("--output", type=Path)
args = parser.parse_args()
config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
output = args.output or config / "decklock/themes/python"
output.mkdir(parents=True, exist_ok=True)
css = (ROOT / "themes/default/style.css").read_text()
source = config / "scc/config.json"
colors = json.loads(source.read_text()).get("osk_colors", {}) if source.is_file() else {}
for original, target in {"button1": "keyboard_background", "button2": "keyboard_dark", "text": "keyboard_text", "hilight": "keyboard_hilight", "pressed": "keyboard_pressed"}.items():
    value = colors.get(original, "")
    if re.fullmatch(r"[0-9a-fA-F]{6}", value):
        css += f"\n@define-color {target} #{value};\n"
legacy = config / "desktop-theme/cores.css"
if legacy.is_file():
    css += "\n" + legacy.read_text() + "\n@define-color accent @primaria;\n"
source = (ROOT / "themes/default/theme.toml").read_text()
source = source.replace('name = "DeckLock Classic"', 'name = "DeckLock Python import"')
media = config / "midias/bloqueio"
files = sorted(p for p in media.glob("*/*") if p.is_file() and p.suffix.lower() in {".jpg", ".jpeg", ".png", ".webp", ".avif", ".bmp", ".webm", ".mp4", ".mkv", ".mov"})
if files:
    source = "background = " + json.dumps(str(files[0]), ensure_ascii=False) + "\n" + source
(output / "theme.toml").write_text(source)
(output / "style.css").write_text(css)
print(output)
